<Window x:Class="ModelDoctor.Views.HelpView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Model Doctor - Health Audit &amp; Scoring Guide" 
        Height="680" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E222A" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="MIT LICENSE" Foreground="#38BDF8" FontSize="11" FontWeight="Bold"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Model Doctor - Health Score &amp; Audit Guide" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Industry standard quality control metrics &amp; scoring classification thresholds" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                
                <!-- Section 1: Overall Health Score Classification -->
                <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="1. Overall Model Health Score Logic" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                        <TextBlock Text="The overall health score is calculated as a weighted average percentage (0% - 100%) across all active (non-ignored) health check rules:" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <!-- Score Badges Grid -->
                        <UniformGrid Columns="3" Margin="0,0,0,6">
                            <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="🟢 PASS / HEALTHY (85% – 100%)" FontWeight="Bold" Foreground="#047857" FontSize="11"/>
                                    <TextBlock Text="Model is clean, performance optimal, ready for coordination and printing deliverables." FontSize="11" Foreground="#065F46" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="🟡 WARNING / NEEDS ATTENTION (65% – 84%)" FontWeight="Bold" Foreground="#B45309" FontSize="11"/>
                                    <TextBlock Text="Model runs smoothly, but requires periodic cleanup before issues expand." FontSize="11" Foreground="#92400E" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="🔴 FAIL / CRITICAL (&lt; 65%)" FontWeight="Bold" Foreground="#B91C1C" FontSize="11"/>
                                    <TextBlock Text="High risk of model lag, corruption, or inaccurate quantity schedules. Immediate fix required!" FontSize="11" Foreground="#991B1B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Section 2: Health Check Categories -->
                <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="2. Health Check Categories" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                        
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="• Model Performance" FontWeight="Bold" Foreground="#2563EB" FontSize="13"/>
                            <TextBlock Text="Focuses on database stability, loading speed, and RAM memory optimization (Warnings, CAD Imports, In-Place Families, Purge Items, View Filters)." FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="12,2,0,0"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="• Data &amp; Deliverable Integrity" FontWeight="Bold" Foreground="#059669" FontSize="13"/>
                            <TextBlock Text="Focuses on quantity schedule accuracy and documentation deliverable quality (Unplaced Rooms, Views on Sheets, Unused Schedules, Broken Links, Duplicate Instances, Groups, Workset Allocation)." FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="12,2,0,0"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="• Spatial &amp; Model Safety" FontWeight="Bold" Foreground="#D97706" FontSize="13"/>
                            <TextBlock Text="Focuses on visual graphics stability and preventing accidental modeling errors (Large Model Extents &gt; 16 km, Unpinned Grids &amp; Levels, View Clipping)." FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="12,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Section 3: Industry Metric Thresholds Table -->
                <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                    <StackPanel>
                        <TextBlock Text="3. Industry Standard Metric Thresholds" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>

                        <!-- Rules Table -->
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Table Header -->
                            <Border Grid.Row="0" Grid.ColumnSpan="4" Background="#F1F5F9" Padding="8,6" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Audit Rule" FontWeight="Bold" FontSize="11" Foreground="#334155"/>
                                    <TextBlock Grid.Column="1" Text="🟢 Pass" FontWeight="Bold" FontSize="11" Foreground="#047857"/>
                                    <TextBlock Grid.Column="2" Text="🟡 Warning" FontWeight="Bold" FontSize="11" Foreground="#B45309"/>
                                    <TextBlock Grid.Column="3" Text="🔴 Fail" FontWeight="Bold" FontSize="11" Foreground="#B91C1C"/>
                                </Grid>
                            </Border>

                            <!-- Row 1 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Active Warnings" FontSize="11" Margin="8,6,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="≤ 50" FontSize="11" Margin="0,6,0,6" Foreground="#047857" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="51 - 200" FontSize="11" Margin="0,6,0,6" Foreground="#B45309"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="&gt; 200" FontSize="11" Margin="0,6,0,6" Foreground="#B91C1C"/>

                            <!-- Row 2 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Imported CAD (DWG)" FontSize="11" Margin="8,6,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="0 files" FontSize="11" Margin="0,6,0,6" Foreground="#047857" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="1 - 2 (2D View)" FontSize="11" Margin="0,6,0,6" Foreground="#B45309"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="&gt; 2 or 3D Layer" FontSize="11" Margin="0,6,0,6" Foreground="#B91C1C"/>

                            <!-- Row 3 -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="In-Place Families" FontSize="11" Margin="8,6,0,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="≤ 2 elems" FontSize="11" Margin="0,6,0,6" Foreground="#047857" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="3 - 10 elems" FontSize="11" Margin="0,6,0,6" Foreground="#B45309"/>
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="&gt; 10 elems" FontSize="11" Margin="0,6,0,6" Foreground="#B91C1C"/>

                            <!-- Row 4 -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Purgeable Items" FontSize="11" Margin="8,6,0,6"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="≤ 100 items" FontSize="11" Margin="0,6,0,6" Foreground="#047857" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="101 - 500" FontSize="11" Margin="0,6,0,6" Foreground="#B45309"/>
                            <TextBlock Grid.Row="4" Grid.Column="3" Text="&gt; 500 items" FontSize="11" Margin="0,6,0,6" Foreground="#B91C1C"/>

                            <!-- Row 5 -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Unplaced Rooms / Spaces" FontSize="11" Margin="8,6,0,6"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="0 rooms" FontSize="11" Margin="0,6,0,6" Foreground="#047857" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" Text="1 - 5 rooms" FontSize="11" Margin="0,6,0,6" Foreground="#B45309"/>
                            <TextBlock Grid.Row="5" Grid.Column="3" Text="&gt; 5 rooms" FontSize="11" Margin="0,6,0,6" Foreground="#B91C1C"/>

                            <!-- Row 6 -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Views Not on Sheets" FontSize="11" Margin="8,6,0,6"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="&lt; 20% views" FontSize="11" Margin="0,6,0,6" Foreground="#047857" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="6" Grid.Column="2" Text="20% - 40%" FontSize="11" Margin="0,6,0,6" Foreground="#B45309"/>
                            <TextBlock Grid.Row="6" Grid.Column="3" Text="&gt; 40% views" FontSize="11" Margin="0,6,0,6" Foreground="#B91C1C"/>

                            <!-- Row 7 -->
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Broken Links (Revit/IFC)" FontSize="11" Margin="8,6,0,6"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="0 issues" FontSize="11" Margin="0,6,0,6" Foreground="#047857" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="7" Grid.Column="2" Text="1 Unloaded" FontSize="11" Margin="0,6,0,6" Foreground="#B45309"/>
                            <TextBlock Grid.Row="7" Grid.Column="3" Text="≥ 1 Not Found" FontSize="11" Margin="0,6,0,6" Foreground="#B91C1C"/>

                            <!-- Row 8 -->
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Duplicate Instances" FontSize="11" Margin="8,6,0,6"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="0 elems" FontSize="11" Margin="0,6,0,6" Foreground="#047857" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="8" Grid.Column="2" Text="1 - 5 elems" FontSize="11" Margin="0,6,0,6" Foreground="#B45309"/>
                            <TextBlock Grid.Row="8" Grid.Column="3" Text="&gt; 5 elems" FontSize="11" Margin="0,6,0,6" Foreground="#B91C1C"/>

                            <!-- Row 9 -->
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Large Model Extents (&gt;16 km)" FontSize="11" Margin="8,6,0,6"/>
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="0 elems" FontSize="11" Margin="0,6,0,6" Foreground="#047857" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="9" Grid.Column="2" Text="0 (Strict)" FontSize="11" Margin="0,6,0,6" Foreground="#B45309"/>
                            <TextBlock Grid.Row="9" Grid.Column="3" Text="≥ 1 elem &gt; 16km" FontSize="11" Margin="0,6,0,6" Foreground="#B91C1C"/>

                            <!-- Row 10 -->
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Unpinned Grids &amp; Levels" FontSize="11" Margin="8,6,0,6"/>
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="100% Pinned" FontSize="11" Margin="0,6,0,6" Foreground="#047857" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="10" Grid.Column="2" Text="90% - 99%" FontSize="11" Margin="0,6,0,6" Foreground="#B45309"/>
                            <TextBlock Grid.Row="10" Grid.Column="3" Text="&lt; 90% Pinned" FontSize="11" Margin="0,6,0,6" Foreground="#B91C1C"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer / Close Button -->
        <Border Grid.Row="2" Background="#F1F5F9" Padding="12,8" Margin="0,12,0,0" CornerRadius="6">
            <DockPanel>
                <Button Content="Close Guide" Click="CloseButton_Click" Background="#2563EB" Foreground="White" Width="100" DockPanel.Dock="Right"/>
                <TextBlock Text="Revit Model Doctor | Open Source under MIT License" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
