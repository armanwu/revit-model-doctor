<Window x:Class="ModelDoctor.Views.HealthCheckDashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:ModelDoctor.Views.Converters"
        mc:Ignorable="d"
        Title="Model Doctor - Health Audit Dashboard &amp; QC Rating" Height="780" Width="1160"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + OVERALL MODEL QC ASSESSMENT BANNER -->
        <Border Grid.Row="0" Background="#1E222A" Padding="20,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Document Info Row -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Model Doctor - Health Audit Dashboard" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="MIT LICENSE" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding DocumentTitle, StringFormat='Document: {0}'}" FontSize="13" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AuditTime, StringFormat='Audit Date: {0}'}" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="❓ Help &amp; Scoring Guide" 
                                Command="{Binding OpenHelpCommand}" 
                                Background="#2563EB" 
                                Foreground="White" 
                                Height="28" 
                                Padding="10,2" 
                                FontSize="11" 
                                FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <!-- OVERALL MODEL QC ASSESSMENT CARD -->
                <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- QC Status Badge -->
                        <Border Grid.Column="0" 
                                Background="{Binding OverallQcColorHex, Converter={StaticResource HexToBrushConverter}}" 
                                CornerRadius="8" Padding="14,8" VerticalAlignment="Center" Margin="0,0,14,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="OVERALL QC ASSESSMENT" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Opacity="0.9"/>
                                <TextBlock Text="{Binding OverallQcStatusText}" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- QC Narrative + Statistical Summary Pills -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OverallQcMessage}" FontSize="12" Foreground="#F1F5F9" TextWrapping="Wrap" FontWeight="Medium"/>
                            
                            <!-- Metric Pills -->
                            <WrapPanel Margin="0,8,0,0">
                                <Border Background="#10B981" CornerRadius="10" Padding="8,2" Margin="0,0,6,4">
                                    <TextBlock Text="{Binding PassedRulesCount, StringFormat='🟢 Pass Rules: {0}'}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <Border Background="#F59E0B" CornerRadius="10" Padding="8,2" Margin="0,0,6,4">
                                    <TextBlock Text="{Binding WarningRulesCount, StringFormat='🟡 Warning Rules: {0}'}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <Border Background="#EF4444" CornerRadius="10" Padding="8,2" Margin="0,0,6,4">
                                    <TextBlock Text="{Binding FailedRulesCount, StringFormat='🔴 Fail Rules: {0}'}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <Border Background="#2563EB" CornerRadius="10" Padding="8,2" Margin="0,0,6,4">
                                    <TextBlock Text="{Binding TotalActiveIssuesCount, StringFormat='🔵 Active Issues: {0}'}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <Border Background="#64748B" CornerRadius="10" Padding="8,2" Margin="0,0,6,4">
                                    <TextBlock Text="{Binding IgnoredCategoriesCount, StringFormat='⚪ Ignored Categories: {0}'}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <Border Background="#475569" CornerRadius="10" Padding="8,2" Margin="0,0,6,4">
                                    <TextBlock Text="{Binding IgnoredRulesCount, StringFormat='⚪ Ignored Rules: {0}'}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content (2 Columns) -->
        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.4*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Category Filter, Audit Rules Summary & Issue Detail -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Category Ignore / Filter Panel -->
                    <RowDefinition Height="1.8*"/> <!-- Audit Rules Summary DataGrid -->
                    <RowDefinition Height="Auto"/> <!-- Splitter -->
                    <RowDefinition Height="1.2*"/> <!-- Issue Detail -->
                </Grid.RowDefinitions>

                <!-- 1. CATEGORY IGNORE / FILTER PANEL -->
                <Border Grid.Row="0" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header controls -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <CheckBox Content="Show Ignored Category/Rule Items" 
                                          IsChecked="{Binding ShowIgnoredCategories}" 
                                          VerticalAlignment="Center" 
                                          FontSize="11" Foreground="#64748B" FontWeight="Medium" Margin="0,0,10,0"/>
                                <Button Content="Include All Rules &amp; Categories" 
                                        Command="{Binding IncludeAllRulesCommand}" 
                                        Background="#059669" Height="26" Padding="8,2" FontSize="11" Margin="0,0,4,0"/>
                                <Button Content="Toggle Categories" 
                                        Command="{Binding ToggleAllCategoriesCommand}" 
                                        Background="#64748B" Height="26" Padding="8,2" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Text="Category &amp; Rule Filter (Uncheck to ignore from QC):" 
                                       FontSize="12" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Category Checkbox List -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding CategoryFilters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding IsIncluded}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding CategoryName}" FontWeight="SemiBold" FontSize="11" Foreground="#1E293B" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ActiveIssueCount, StringFormat=' ({0} issues)'}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                            
                                            <!-- Ignored Tag Badge if unchecked -->
                                            <Border Margin="6,0,0,0" Padding="4,1" CornerRadius="3" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="IGNORED" Foreground="#DC2626" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- 2. AUDIT RULES SUMMARY DATAGRID -->
                <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <Button Content="Toggle Selected Rule Ignore" 
                                    Command="{Binding ToggleSelectedRuleIgnoreCommand}" 
                                    DockPanel.Dock="Right" 
                                    Background="#D97706" 
                                    Height="26" 
                                    Padding="10,2" 
                                    FontSize="11"/>
                            <TextBlock Text="Audit Rules Summary (Uncheck QC column or click Toggle to ignore specific Rule Name):" 
                                       FontSize="13" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        </DockPanel>

                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding RuleResults}" 
                                  SelectedItem="{Binding SelectedRule}"
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="False" 
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  HeadersVisibility="Column"
                                  CanUserReorderColumns="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowHeight="34">
                            <DataGrid.Columns>
                                <!-- QC Active Checkbox Column for Rule Name Ignoring -->
                                <DataGridTemplateColumn Header="QC" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsRuleIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"
                                                      ToolTip="Check to include rule in QC; uncheck to ignore rule."/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Status Badge -->
                                <DataGridTemplateColumn Header="Status" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalAlignment="Center">
                                                <!-- Ignored Badge -->
                                                <Border Background="#64748B" CornerRadius="12" Padding="8,3" HorizontalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEffectivelyIgnored}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="IGNORED" Foreground="White" FontWeight="Bold" FontSize="10"/>
                                                </Border>

                                                <!-- Active Status Badge -->
                                                <Border Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}" 
                                                        CornerRadius="12" Padding="8,3" HorizontalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEffectivelyIgnored}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" FontWeight="Medium" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Rule Name" Binding="{Binding RuleName}" Width="170" FontWeight="SemiBold" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Issues" Binding="{Binding Count}" Width="55" IsReadOnly="True"/>

                                <!-- Quick Fix Button Column -->
                                <DataGridTemplateColumn Header="Auto Fix" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="⚡ Quick Fix" 
                                                    Command="{Binding DataContext.ExecuteQuickFixCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#D97706" 
                                                    Foreground="White"
                                                    FontSize="10" 
                                                    FontWeight="Bold"
                                                    Padding="6,2"
                                                    Height="24"
                                                    ToolTip="{Binding QuickFixDescription}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanQuickFix}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Rule Overview" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="2" Height="8" Background="Transparent" VerticalAlignment="Center"/>

                <!-- 3. SPECIFIC ELEMENT ISSUE EXPLANATION CARD -->
                <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Specific Element Issue Explanation" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>

                        <Border Grid.Row="1" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedElement.ElementIdValue, StringFormat='Selected Element ID: {0}'}" 
                                               FontWeight="Bold" Foreground="#991B1B" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedElement.IssueDescription}" 
                                               Foreground="#7F1D1D" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="10" Background="Transparent" HorizontalAlignment="Center"/>

            <!-- RIGHT COLUMN: Offending Elements ListBox & Action Buttons -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Offending Elements List" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>

                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <CheckBox Content="Show Ignored" 
                                  IsChecked="{Binding ShowIgnoredItems}" 
                                  DockPanel.Dock="Right" 
                                  VerticalAlignment="Center" 
                                  HorizontalAlignment="Right" 
                                  FontSize="11" 
                                  Foreground="#64748B" 
                                  FontWeight="Medium"/>
                        <StackPanel DockPanel.Dock="Left">
                            <Border Background="#E0F2FE" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding SelectedRule.Category, StringFormat='Category: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                            </Border>
                            <TextBlock Text="{Binding SelectedRule.RuleName, StringFormat='Rule: {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Element ID Selection List -->
                    <Border Grid.Row="2" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                        <ListBox ItemsSource="{Binding OffendingElements}" 
                                 SelectedItem="{Binding SelectedElement}"
                                 MouseDoubleClick="ListBox_MouseDoubleClick"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4">
                                        <TextBlock Text="ElementId: " Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Text="{Binding ElementIdValue}" FontWeight="Bold" Foreground="#0F172A" FontSize="12"/>
                                        <Border Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="[Ignored]" Foreground="#6B7280" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="3">
                        <Button Content="⚡ Quick Fix Selected Rule" 
                                Command="{Binding ExecuteQuickFixCommand}" 
                                CommandParameter="{Binding SelectedRule}"
                                Background="#D97706" 
                                Foreground="White" 
                                Height="34"
                                Margin="0,0,0,4"
                                ToolTip="{Binding SelectedRule.QuickFixDescription}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRule.CanQuickFix}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Select &amp; Show in Revit" 
                                Command="{Binding SelectAndShowElementCommand}" 
                                Background="#2563EB" 
                                Foreground="White" 
                                Height="34"
                                Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Ignore Element" 
                                    Command="{Binding IgnoreSelectedElementCommand}" 
                                    Background="#D97706" 
                                    Foreground="White" 
                                    Height="32"
                                    Margin="0,0,2,0"/>
                            <Button Grid.Column="1" Content="Unignore Element" 
                                    Command="{Binding UnignoreSelectedElementCommand}" 
                                    Background="#059669" 
                                    Foreground="White" 
                                    Height="32"
                                    Margin="2,0,0,0"/>
                        </Grid>
                        <Button Content="Copy Selected Element ID" 
                                Command="{Binding CopySelectedElementIdCommand}" 
                                Background="#0EA5E9" 
                                Foreground="White" 
                                Height="32"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer / Copyright & Close Action Button -->
        <Border Grid.Row="2" Background="#F1F5F9" Padding="15,10" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Created by Arman Arisman | Copyright © 2026 Arman Arisman." 
                               Foreground="#64748B" 
                               FontSize="12" 
                               VerticalAlignment="Center" 
                               FontWeight="Medium"/>
                    <Border Background="#E0F2FE" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Licensed under MIT License" Foreground="#0369A1" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Export to CSV" 
                            Command="{Binding ExportCsvCommand}" 
                            Background="#059669" 
                            Foreground="White"
                            Margin="0,0,10,0"
                            Padding="14,8"/>
                    <Button Content="Close" 
                            Command="{Binding CloseCommand}" 
                            Background="#64748B" 
                            Foreground="White"
                            Width="90"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
