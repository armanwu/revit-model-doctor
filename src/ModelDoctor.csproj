<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>ModelDoctor</AssemblyName>
    <RootNamespace>ModelDoctor</RootNamespace>
    <Authors>Arman Arisman</Authors>
    <Copyright>Copyright (c) 2026 Arman Arisman. All rights reserved.</Copyright>
    <Version>1.0.0</Version>
    <Description>Revit Model Doctor - Rule-Based Health Check Engine Add-In for Revit 2025, 2026, and 2027</Description>
  </PropertyGroup>

  <!-- Dynamic Revit API References (Prioritize Revit 2025 for net8.0-windows compatibility) -->
  <PropertyGroup>
    <RevitVersionDir Condition="Exists('C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll')">C:\Program Files\Autodesk\Revit 2025</RevitVersionDir>
    <RevitVersionDir Condition="'$(RevitVersionDir)' == '' and Exists('C:\Program Files\Autodesk\Revit 2026\RevitAPI.dll')">C:\Program Files\Autodesk\Revit 2026</RevitVersionDir>
    <RevitVersionDir Condition="'$(RevitVersionDir)' == '' and Exists('C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll')">C:\Program Files\Autodesk\Revit 2027</RevitVersionDir>
    <RevitVersionDir Condition="'$(RevitVersionDir)' == ''">C:\Program Files\Autodesk\Revit 2025</RevitVersionDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitVersionDir)\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitVersionDir)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Include Icons as WPF Resources and Embedded Resources -->
  <ItemGroup>
    <Resource Include="Icon\**\*.*" />
    <EmbeddedResource Include="Icon\**\*.*" />
  </ItemGroup>

  <!-- Include Revit Add-In Manifest in Output -->
  <ItemGroup>
    <None Update="Manifest\model-doctor.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
